{
  "name": "lytex-operations-os",
  "version": "0.3.0",
  "private": true,
  "description": "LYTEX Operations OS – local-first business operations (CRM, projects, tickets, time tracking, billing) for Obsidian.",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json --threshold error",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:perf": "LYTEX_PERF=1 vitest run tests/perf",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "deploy": "node scripts/deploy.mjs",
    "example-vault": "node scripts/build-example-vault.mjs",
    "check-data": "node scripts/check-data.mjs",
    "release": "node scripts/release.mjs",
    "dist": "node scripts/publish-dist.mjs"
  },
  "license": "MIT",
  "author": "LYTEX",
  "dependencies": {
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "22.20.5",
    "builtin-modules": "5.4.0",
    "esbuild": "0.28.2",
    "esbuild-svelte": "0.9.5",
    "eslint": "10.13.0",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "obsidian": "1.14.4",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "crm",
    "time-tracking",
    "invoicing",
    "freelance",
    "kanban",
    "local-first"
  ]
}
